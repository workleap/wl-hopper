{
    "name": "@hopper-ui/styled-system",
    "version": "4.0.13",
    "description": "The styled-system package.",
    "license": "Apache-2.0",
    "author": "Workleap",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/workleap/wl-hopper.git",
        "directory": "packages/styled-system"
    },
    "style": "dist/index.css",
    "files": [
        "/dist",
        "CHANGELOG.md"
    ],
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "hopper-source": "./src/index.ts",
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./index.css": "./dist/index.css",
        "./theme/*.css": "./dist/theme/generated/*.css"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "dev": "rslib build -w -c ./rslib.dev.ts",
        "build": "rslib build -c ./rslib.build.ts",
        "stylelint": "stylelint \"**/*.css\" --allow-empty-input --config ../../.stylelintrc.js --cache --cache-location node_modules/.cache/stylelint --max-warnings=0",
        "typecheck": "tsc",
        "test": "vitest run"
    },
    "dependencies": {
        "@react-aria/ssr": "^3.10.1",
        "clsx": "^2.1.1",
        "csstype": "^3.2.3"
    },
    "devDependencies": {
        "@hopper-ui/rslib-config": "workspace:*",
        "@hopper-ui/tokens": "workspace:*",
        "@hopper-ui/vitest-config": "workspace:*",
        "@rslib/core": "0.23.2",
        "@testing-library/dom": "10.4.1",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.2",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@workleap/rslib-configs": "1.2.1",
        "@workleap/typescript-configs": "5.0.0",
        "minimatch": "10.2.6",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "typescript": "6.0.3"
    },
    "peerDependencies": {
        "react": "^18 || ^19",
        "react-dom": "^18 || ^19"
    }
}
