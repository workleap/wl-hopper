{
    "name": "docs",
    "version": "0.4.5",
    "private": true,
    "description": "The documentation website",
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "browser": {
        "fs": false
    },
    "scripts": {
        "start": "next start",
        "dev": "next dev --webpack",
        "build": "next build --webpack",
        "copy:ai-docs-to-public": "shx rm -rf public/ai-docs && shx mkdir -p public && shx cp -r dist/ai-docs public",
        "build:ai-docs": "tsx --tsconfig ./scripts/ai-utils/tsconfig.json scripts/buildAiDocs.ts && pnpm copy:ai-docs-to-public",
        "copy:skills-to-public": "shx rm -rf public/agent-skills && shx mkdir -p public && shx cp -r dist/skills public/agent-skills",
        "build:skills": "tsx --tsconfig ./scripts/ai-utils/tsconfig.json scripts/buildSkills.ts && pnpm copy:skills-to-public",
        "test": "tsx --tsconfig ./scripts/ai-utils/tsconfig.json scripts/checkSkillsConfig.ts",
        "generate": "pnpm run \"/^generate:.*/\"",
        "generate:componentData": "node scripts/generateComponentData.ts",
        "generate:previewRef": "node scripts/generatePreviewRef.ts",
        "copy:images": "node scripts/copyImages.ts"
    },
    "dependencies": {
        "clsx": "2.1.1",
        "contentlayer2": "0.5.8",
        "next": "16.3.1",
        "next-contentlayer2": "0.5.8",
        "next-mdx-remote": "6.0.0",
        "react": "19.2.8",
        "react-aria": "3.51.0",
        "react-aria-components": "1.20.0",
        "react-dom": "19.2.8",
        "react-hook-form": "7.85.0",
        "react-toggle": "4.1.3",
        "rehype-parse": "9.0.1",
        "rehype-pretty-code": "0.14.5",
        "rehype-react": "8.0.0",
        "unified": "11.0.5",
        "unist-util-visit": "5.1.0"
    },
    "devDependencies": {
        "@codesandbox/sandpack-react": "2.20.0",
        "@hopper-ui/components": "workspace:*",
        "@hopper-ui/icons": "workspace:*",
        "@hopper-ui/rslib-config": "workspace:*",
        "@hopper-ui/svg-icons": "workspace:*",
        "@hopper-ui/tokens": "workspace:*",
        "@internationalized/string-compiler": "3.4.1",
        "@svgr/webpack": "8.1.0",
        "@types/mdast": "4.0.4",
        "@types/node": "26.2.0",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@workleap/browserslist-config": "2.1.8",
        "@workleap/postcss-configs": "1.1.11",
        "@workleap/typescript-configs": "5.0.0",
        "acorn": "8.15.0",
        "acorn-jsx": "5.3.2",
        "esbuild": "0.25.11",
        "glob": "13.0.6",
        "logrocket": "12.1.1",
        "mdast-util-mdx": "3.0.0",
        "mdx-bundler": "10.1.1",
        "react-docgen-typescript": "2.4.0",
        "rehype-remark": "10.0.1",
        "remark": "15.0.1",
        "remark-frontmatter": "5.0.0",
        "remark-gfm": "4.0.1",
        "remark-mdx": "3.1.1",
        "remark-parse": "11.0.0",
        "remark-stringify": "11.0.0",
        "shiki": "4.4.3",
        "shx": "0.4.0",
        "typescript": "6.0.3",
        "vfile": "6.0.3",
        "vfile-matter": "5.0.1"
    }
}
