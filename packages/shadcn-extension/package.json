{
    "name": "@hopper-ui/shadcn-extension",
    "version": "0.0.0",
    "description": "The shadcn extension package.",
    "license": "Apache-2.0",
    "author": "Workleap",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/workleap/wl-hopper.git",
        "directory": "packages/shadcn-extension"
    },
    "style": "dist/index.css",
    "files": [
        "/dist",
        "CHANGELOG.md"
    ],
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "hopper-source": "./src/index.ts",
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./index.css": "./dist/index.css"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "rslib build -c ./rslib.build.ts",
        "stylelint": "stylelint \"**/*.css\" --config ../../.stylelintrc.js --allow-empty-input --cache --cache-location node_modules/.cache/stylelint --max-warnings=0",
        "typecheck": "tsc"
    },
    "dependencies": {
        "clsx": "^2.1.1"
    },
    "devDependencies": {
        "@hopper-ui/components": "workspace:*",
        "@hopper-ui/rslib-config": "workspace:*",
        "@hopper-ui/styled-system": "workspace:*",
        "@rslib/core": "0.23.2",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@workleap/rslib-configs": "1.2.1",
        "@workleap/typescript-configs": "5.0.0",
        "react": "19.2.8",
        "react-aria-components": "1.20.0",
        "react-dom": "19.2.8",
        "typescript": "6.0.3"
    },
    "peerDependencies": {
        "@hopper-ui/components": "*",
        "@hopper-ui/styled-system": "*",
        "react": "^18 || ^19",
        "react-aria-components": "^1.20.0",
        "react-dom": "^18 || ^19"
    }
}
