{
    "name": "@hopper-ui/components",
    "author": "Workleap",
    "version": "3.1.1",
    "description": "The components package.",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/workleap/wl-hopper.git",
        "directory": "packages/components"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "style": "dist/index.css",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./index.css": "./dist/index.css"
    },
    "files": [
        "/dist",
        "CHANGELOG.md"
    ],
    "scripts": {
        "dev": "tsup --config ./tsup.dev.ts",
        "build": "cross-env NODE_OPTIONS=--max-old-space-size=16384 tsup --config ./tsup.build.ts",
        "eslint": "eslint . --max-warnings=0 --cache --cache-location node_modules/.cache/eslint",
        "stylelint": "stylelint \"**/*.css\" --config ../../.stylelintrc.js --allow-empty-input --cache --cache-location node_modules/.cache/stylelint --max-warnings=0",
        "typecheck": "tsc",
        "test": "vitest run",
        "find-types": "tsx scripts/findImportedTypes.ts"
    },
    "peerDependencies": {
        "@hopper-ui/styled-system": "*",
        "react": "^18 || ^19",
        "react-aria": "^3.44.0",
        "react-aria-components": "^1.13.0",
        "react-dom": "^18 || ^19"
    },
    "dependencies": {
        "@hopper-ui/icons": "*",
        "@internationalized/date": "^3.10.0",
        "@react-aria/interactions": "^3.25.6",
        "@react-aria/ssr": "^3.9.10",
        "@react-aria/utils": "^3.31.0",
        "@react-stately/data": "^3.14.0",
        "@react-stately/utils": "^3.10.8",
        "@react-types/shared": "^3.28.0",
        "clsx": "^2.1.1"
    },
    "devDependencies": {
        "@eslint/js": "9.38.0",
        "@hopper-ui/icons": "workspace:*",
        "@hopper-ui/styled-system": "workspace:*",
        "@testing-library/dom": "10.4.1",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.0",
        "@testing-library/user-event": "14.6.1",
        "@types/eslint": "9.6.1",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@workleap/eslint-configs": "0.0.7",
        "@workleap/tsup-configs": "3.1.0",
        "@workleap/typescript-configs": "3.0.4",
        "eslint": "9.38.0",
        "eslint-plugin-import": "2.32.0",
        "jest-fail-on-console": "3.3.1",
        "react": "19.2.8",
        "react-aria": "3.44.0",
        "react-aria-components": "1.13.0",
        "react-dom": "19.2.8",
        "tsup": "8.5.0",
        "typescript": "5.5.4",
        "typescript-eslint": "8.46.2"
    }
}
