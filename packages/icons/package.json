{
    "name": "@hopper-ui/icons",
    "version": "3.0.1",
    "description": "The icons package.",
    "license": "Apache-2.0",
    "author": "Workleap",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/workleap/wl-hopper.git",
        "directory": "packages/icons"
    },
    "style": "dist/index.css",
    "files": [
        "/dist",
        "CHANGELOG.md"
    ],
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./index.css": "./dist/index.css"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "tsup --config ./tsup.build.ts",
        "generate-icons": "node scripts/build.ts",
        "stylelint": "stylelint \"**/*.css\" --config ../../.stylelintrc.js --allow-empty-input --cache --cache-location node_modules/.cache/stylelint --max-warnings=0",
        "typecheck": "tsc",
        "test": "vitest run"
    },
    "dependencies": {
        "@react-aria/utils": "^3.31.0",
        "clsx": "^2.1.1"
    },
    "devDependencies": {
        "@hopper-ui/styled-system": "workspace:*",
        "@svgr/core": "8.1.0",
        "@svgr/plugin-jsx": "8.1.0",
        "@svgr/plugin-svgo": "8.1.0",
        "@testing-library/dom": "10.4.1",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.0",
        "@types/node": "24.5.1",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@workleap/tsup-configs": "3.1.0",
        "@workleap/typescript-configs": "3.0.4",
        "jest-fail-on-console": "3.3.1",
        "react": "19.2.8",
        "react-aria-components": "1.13.0",
        "react-dom": "19.2.8",
        "svgo": "4.0.0",
        "ts-node": "10.9.2",
        "tsup": "8.5.0",
        "typescript": "5.5.4"
    },
    "peerDependencies": {
        "@hopper-ui/styled-system": "*",
        "react": "^18 || ^19",
        "react-aria-components": "^1.13.0",
        "react-dom": "^18 || ^19"
    }
}
