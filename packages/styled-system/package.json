{
    "name": "@hopper-ui/styled-system",
    "version": "4.0.10",
    "description": "The styled-system package.",
    "license": "Apache-2.0",
    "author": "Workleap",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/workleap/wl-hopper.git",
        "directory": "packages/styled-system"
    },
    "style": "dist/index.css",
    "files": [
        "/dist",
        "CHANGELOG.md"
    ],
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./index.css": "./dist/index.css",
        "./theme/*.css": "./dist/theme/generated/*.css"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "dev": "tsup --config ./tsup.dev.ts",
        "build": "tsup --config ./tsup.build.ts && copyfiles -u 1 src/theme/generated/*.css dist && copyfiles -u 1 src/theme/generated/**/*.css dist",
        "stylelint": "stylelint \"**/*.css\" --allow-empty-input --config ../../.stylelintrc.js --cache --cache-location node_modules/.cache/stylelint --max-warnings=0",
        "typecheck": "tsc",
        "test": "vitest run"
    },
    "dependencies": {
        "@react-aria/ssr": "^3.9.10",
        "clsx": "^2.1.1",
        "csstype": "^3.1.3"
    },
    "devDependencies": {
        "@hopper-ui/tokens": "workspace:*",
        "@testing-library/dom": "10.4.1",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.0",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@workleap/tsup-configs": "4.0.2",
        "@workleap/typescript-configs": "5.0.0",
        "copyfiles": "2.4.1",
        "jest-fail-on-console": "3.3.1",
        "minimatch": "10.0.3",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "tsup": "8.5.1",
        "typescript": "7.0.2"
    },
    "peerDependencies": {
        "react": "^18 || ^19",
        "react-dom": "^18 || ^19"
    }
}
