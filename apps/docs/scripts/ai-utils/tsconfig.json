{
    "extends": "@workleap/typescript-configs/web-application.json",
    "compilerOptions": {
        "jsx": "react-jsx",
        "baseUrl": "../..",
        "customConditions": ["hopper-source"],
        "paths": {
            "@/*": ["./*"],
            "@/.contentlayer/generated": ["./.contentlayer/generated/index.mjs"]
        }
    },
    "include": [
        "../../next-env.d.ts",
        "../../**/*.ts",
        "../../**/*.tsx",
        "../../.next/types/**/*.ts",
        "../../.contentlayer/generated",
        "../../.storybook/**/*"
    ],
    "exclude": ["../../node_modules"]
}
