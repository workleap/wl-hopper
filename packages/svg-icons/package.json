{
    "name": "@hopper-ui/svg-icons",
    "version": "2.19.3",
    "description": "A set of icons handcrafted by Workleap",
    "license": "Apache-2.0",
    "author": "Workleap",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/workleap/wl-hopper.git",
        "directory": "packages/svg-icons"
    },
    "files": [
        "/dist",
        "CHANGELOG.md"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        "./icons/*.svg": "./dist/icons/*.svg",
        "./icons/inline": {
            "types": "./dist/icons/inline/index.d.ts",
            "import": "./dist/icons/inline/index.js",
            "default": "./dist/icons/inline/index.js"
        },
        "./rich-icons/*.svg": "./dist/rich-icons/*.svg"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "pnpm run \"/^build:.*/\"",
        "build:icons": "copyfiles --flat src/optimized-icons/* dist/icons",
        "build:inline-icons": "node scripts/buildInlineIcons.ts",
        "build:rich-icons": "copyfiles --flat src/optimized-rich-icons/* dist/rich-icons",
        "build:metadata": "node scripts/buildIconsMetadata.ts",
        "generate-icons": "node scripts/generate.ts",
        "typecheck": "tsc",
        "test": "vitest run"
    },
    "devDependencies": {
        "@hopper-ui/vitest-config": "workspace:*",
        "@types/node": "24.5.1",
        "@workleap/typescript-configs": "3.0.4",
        "copyfiles": "2.4.1",
        "hast-util-select": "6.0.4",
        "rehype-parse": "9.0.1",
        "svgo": "4.0.0",
        "typescript": "5.5.4",
        "unified": "11.0.5"
    }
}
