{
    "name": "@hopper-ui/components",
    "version": "3.3.0",
    "description": "The components package.",
    "license": "Apache-2.0",
    "author": "Workleap",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/workleap/wl-hopper.git",
        "directory": "packages/components"
    },
    "style": "dist/index.css",
    "files": [
        "/dist",
        "CHANGELOG.md"
    ],
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "hopper-source": "./src/index.ts",
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./index.css": "./dist/index.css"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "dev": "rslib build -w -c ./rslib.dev.ts",
        "build": "rslib build -c ./rslib.build.ts",
        "stylelint": "stylelint \"**/*.css\" --config ../../.stylelintrc.js --allow-empty-input --cache --cache-location node_modules/.cache/stylelint --max-warnings=0",
        "typecheck": "tsc",
        "test": "vitest run",
        "find-types": "node scripts/findImportedTypes.ts"
    },
    "dependencies": {
        "@hopper-ui/icons": "workspace:*",
        "@internationalized/date": "^3.12.3",
        "@react-aria/interactions": "^3.28.1",
        "@react-aria/ssr": "^3.10.1",
        "@react-aria/utils": "^3.34.1",
        "@react-stately/data": "^3.16.1",
        "@react-stately/utils": "^3.12.1",
        "@react-types/shared": "^3.36.1",
        "clsx": "^2.1.1"
    },
    "devDependencies": {
        "@hopper-ui/icons": "workspace:*",
        "@hopper-ui/rslib-config": "workspace:*",
        "@hopper-ui/styled-system": "workspace:*",
        "@hopper-ui/vite-intl-plugin": "workspace:*",
        "@hopper-ui/vitest-config": "workspace:*",
        "@rslib/core": "0.23.2",
        "@testing-library/dom": "10.4.1",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.2",
        "@testing-library/user-event": "14.6.5",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@workleap/rslib-configs": "1.2.1",
        "@workleap/typescript-configs": "5.0.0",
        "react": "19.2.8",
        "react-aria": "3.51.0",
        "react-aria-components": "1.20.0",
        "react-dom": "19.2.8",
        "typescript": "6.0.3"
    },
    "peerDependencies": {
        "@hopper-ui/styled-system": "*",
        "react": "^18 || ^19",
        "react-aria": "^3.51.0",
        "react-aria-components": "^1.20.0",
        "react-dom": "^18 || ^19"
    }
}
