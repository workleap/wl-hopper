{
    "$schema": "https://unpkg.com/@changesets/config@4.0.0/schema.json",
    "changelog": ["@changesets/cli/changelog", { "repo": "workleap/wl-hopper" }],
    "commit": false,
    "fixed": [],
    "access": "restricted",
    "baseBranch": "main",
