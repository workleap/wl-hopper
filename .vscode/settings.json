{
    "search.exclude": {
        "**/node_modules*": true,
        "**/dist*": true,
        "**/.next*": true,
        "**/.cache*": true,
        "**/.contentlayer*": true
    },

    // Formatters settings
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.codeActionsOnSave": {
        "source.organizeImports": "never",
        "source.format.oxc": "always",
        "source.fixAll.oxc": "always"
    },
    "[html]": {
        "editor.formatOnSave": false
    },

    // Languages
    "typescript.format.enable": false, // Disables the default formatter to use oxfmt instead
    "typescript.preferences.useAliasesForRenames": false,
    "typescript.tsdk": "node_modules\\typescript\\lib",

    "javascript.format.enable": false, // Disables the default formatter to use oxfmt instead
    "javascript.preferences.useAliasesForRenames": false,

    "json.format.enable": false, // Disables the default formatter to use oxfmt instead

    "css.validate": false, // Disables the default formatter to use Stylelint instead

    // Settings for third parties that are frequently used
    "files.associations": {
        "*.snap": "javascriptreact"
    }
}
