{
    "name": "wl-hopper",
    "version": "0.0.0",
    "private": true,
    "description": "A React component library that provides accessible, customizable, and production-ready UI components.",
    "homepage": "https://github.com/workleap/wl-hopper#readme",
    "bugs": {
        "url": "https://github.com/workleap/wl-hopper/issues"
    },
    "license": "Apache-2.0",
    "author": {
        "name": "Workleap"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/workleap/wl-hopper.git"
    },
    "type": "module",
    "scripts": {
        "doc:start": "pnpm --filter=docs dev",
        "doc:generate": "turbo run generate --filter=docs",
        "dev:basic": "pnpm -r --filter=basic dev",
        "dev:mcp": "pnpm -r --filter=mcp-server dev",
        "test": "turbo run test --continue",
        "test-storybook": "test-storybook",
        "build:doc": "turbo run build --filter=./apps/docs",
        "build:ai-docs": "turbo run build:ai-docs --filter=docs",
        "build:skills": "turbo run build:skills --filter=docs",
        "build:mcp": "turbo run build --filter=@hopper-ui/mcp-server",
        "build:tokens": "turbo run build --filter=./packages/tokens",
        "build:pkg": "turbo run build --filter=./packages/*",
        "build:apps": "turbo run build --filter=./apps/samples/*",
        "changeset": "changeset",
        "ci-version-packages": "changeset version && pnpm build:tokens",
        "ci-release": "pnpm build:pkg && changeset publish",
        "install-react18": "pnpm -r --filter \"{packages/**}\" --filter \"@hopper-ui/test-utils\" --filter \"@hopper-ui/storybook-addon\" add -D react@18 react-dom@18 @types/react@18 @types/react-dom@18 && pnpm add -D -w react@18 react-dom@18 @types/react@18 @types/react-dom@18",
        "generate-icons": "pnpm --filter=\"svg-icons\" generate-icons && pnpm --filter=\"@hopper-ui/icons*\" generate-icons",
        "lint": "oxlint && pnpm format:check && turbo run stylelint typecheck syncpack --continue",
        "oxlint": "oxlint",
        "format": "oxfmt . \"!**/*.css\"",
        "format:check": "oxfmt . \"!**/*.css\" --check",
        "syncpack": "syncpack lint",
        "typecheck": "tsc",
        "clean": "pnpm -r --parallel --include-workspace-root exec pnpm dlx rimraf dist node_modules/.cache",
        "reset": "pnpm clean && pnpm reset:modules",
        "reset:modules": "pnpm -r --parallel --include-workspace-root exec pnpm dlx rimraf node_modules pnpm-lock.yaml",
        "storybook": "storybook dev -p 6006",
        "storybook-nolazy": "cross-env STORYBOOK_NO_LAZY=true pnpm run storybook",
        "build-storybook": "storybook build",
        "list-outdated-deps": "pnpm outdated -r --format list !react !react-dom !@types/react !@types/react-dom !@types/node !typescript !stylelint",
        "update-outdated-deps": "pnpm update -r --latest !react !react-dom !@types/react !@types/react-dom !@types/node !typescript !stylelint",
        "update-react-aria-deps": "pnpm update -r react-aria react-aria-components @react-aria/* @react-stately/*",
        "find-types": "pnpm --filter=components find-types"
    },
    "devDependencies": {
        "@changesets/cli": "3.0.1",
        "@chromatic-com/storybook": "5.3.0",
        "@hopper-ui/rslib-config": "workspace:*",
        "@hopper-ui/storybook-addon": "workspace:*",
        "@hopper-ui/styled-system": "workspace:*",
        "@hopper-ui/test-utils": "workspace:*",
        "@hopper-ui/tokens": "workspace:*",
        "@internationalized/string-compiler": "3.4.1",
        "@netlify/plugin-nextjs": "5.15.13",
        "@rsbuild/core": "2.1.13",
        "@rslib/core": "0.23.2",
        "@rspack/core": "2.1.10",
        "@storybook/addon-a11y": "10.5.10",
        "@storybook/addon-docs": "10.5.10",
        "@storybook/test-runner": "0.24.4",
        "@testing-library/react": "16.3.2",
        "@types/node": "26.2.0",
        "@types/react": "19.2.18",
        "@workleap/rsbuild-configs": "4.1.1",
        "@workleap/rslib-configs": "1.2.1",
        "@workleap/stylelint-configs": "2.1.11",
        "@workleap/typescript-configs": "5.0.0",
        "axe-playwright": "2.2.2",
        "chromatic": "18.5.0",
        "cross-env": "10.1.0",
        "jsdom": "30.0.1",
        "oxfmt": "0.64.0",
        "oxlint": "1.79.0",
        "postcss": "8.5.26",
        "prettier": "3.9.6",
        "prop-types": "15.8.1",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-hook-form": "7.85.0",
        "react-router-dom": "7.18.2",
        "shx": "0.4.0",
        "storybook": "10.5.10",
        "storybook-react-rsbuild": "3.4.2",
        "stylelint": "16.26.1",
        "stylelint-config-clean-order": "10.0.0",
        "stylelint-order": "8.1.1",
        "stylelint-use-logical": "2.1.3",
        "syncpack": "15.3.3",
        "ts-node": "10.9.2",
        "tsx": "4.23.12",
        "turbo": "2.10.11",
        "typescript": "6.0.3",
        "vite": "8.2.2",
        "vitest": "4.1.11"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "26.x",
            "onFail": "download"
        }
    },
    "packageManager": "pnpm@11.22.0"
}
